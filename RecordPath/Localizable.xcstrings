    },
    "和朋友共享你的足迹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your footprints with friends"
          }
        }
      }
    },
    "在哪里比对": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it's compared"
          }
        }
