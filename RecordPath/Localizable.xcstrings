        }
      }
    },
    "还没有交汇": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No crossings yet"
          }
        }
      }
    },
    "邀请一个朋友，看看你们的足迹在哪里交汇。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite a friend and see where your footprints cross."
          }
        }
