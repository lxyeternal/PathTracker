            "state": "translated",
            "value": "Recording since %@"
          }
        }
      }
    },
    "从“%@”到“%@”的所有记录，点一条查看那一天。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every trip from “%1$@” to “%2$@”. Tap one to see that day."
