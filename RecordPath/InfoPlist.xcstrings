    "GPS Exchange Format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS Exchange Format"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your steps and walking distance to show how far you walk each day. This data stays on your devices and in your iCloud."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps recording your routes in the background and marks the places, cities and countries you visit. Your tracks are stored only in your own iCloud."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the routes you take and shows your position on the map."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detects whether you are walking, cycling or riding, for more accurate tracks and better battery life."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds photos to your trips."
          }
        }
      }
    }
  },
  "version": "1.0"
}