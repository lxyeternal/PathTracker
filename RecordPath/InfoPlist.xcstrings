{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waytrace"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waytrace"
          }
        }
      }
    },
    "GPS Exchange Format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS Exchange Format"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your steps and walking distance to show how far you walk each day. This data stays on your devices and in your iCloud."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the hikes, runs and rides you record on Apple Watch be saved as workouts in Fitness. Waytrace never changes your other health data."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps recording your routes in the background and marks the places, cities and countries you visit. Your tracks are stored only in your own iCloud."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the routes you take and shows your position on the map."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detects whether you are walking, cycling or riding, for more accurate tracks and better battery life."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the photos you took at each place on your timeline, lights up places you've been from where your photos were taken, and adds photos to trips. Photos are read on your iPhone only and never uploaded."
          }
        }
      }
    }
  },
  "version": "1.0"
}