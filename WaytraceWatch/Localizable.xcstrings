{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%lld": {
      "shouldTranslate": false
    },
    "iPhone 不在附近，显示的是 %@ 的数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone isn't nearby. Showing data from %@."
          }
        }
      }
    },
    "iPhone 全天记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All-Day Recording on iPhone"
          }
        }
      }
    },
    "iPhone 在附近时会自动同步到“旅程”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs to Trips when your iPhone is nearby"
          }
        }
      }
    },
    "今天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "去过的地点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places"
          }
        }
      }
    },
    "地点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places"
          }
        }
      }
    },
    "好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "已保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved"
          }
        }
      }
    },
    "已保存到 iPhone 的“旅程”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Trips on your iPhone"
          }
        }
      }
    },
    "已在 iPhone 上关闭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off on your iPhone"
          }
        }
      }
    },
    "已暂停": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        }
      }
    },
    "开始记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Recording"
          }
        }
      }
    },
    "徒步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiking"
          }
        }
      }
    },
    "打开 iPhone 上的漫迹，这里就会显示今天的路线。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Waytrace on your iPhone to see today's route here."
          }
        }
      }
    },
    "无法开始记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Start Recording"
          }
        }
      }
    },
    "无法开始记录。请在 iPhone 的“健康”App 中允许漫迹记录体能训练。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start recording. In the Health app on your iPhone, allow Waytrace to save workouts."
          }
        }
      }
    },
    "昨天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        }
      }
    },
    "暂停": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        }
      }
    },
    "暂停 1 小时": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause for 1 Hour"
          }
        }
      }
    },
    "暂停到 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused until %@"
          }
        }
      }
    },
    "暂停到明天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause Until Tomorrow"
          }
        }
      }
    },
    "正在保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving"
          }
        }
      }
    },
    "正在同步到 iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing to your iPhone"
          }
        }
      }
    },
    "步数": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps"
          }
        }
      }
    },
    "步行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking"
          }
        }
      }
    },
    "漫迹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waytrace"
          }
        }
      }
    },
    "移动距离": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance Traveled"
          }
        }
      }
    },
    "结束": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "结束并保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End and Save"
          }
        }
      }
    },
    "结束这次记录？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End this recording?"
          }
        }
      }
    },
    "继续": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "继续记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Recording"
          }
        }
      }
    },
    "记录已暂停": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording Paused"
          }
        }
      }
    },
    "跑步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        }
      }
    },
    "距离": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance"
          }
        }
      }
    },
    "跟随系统": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        }
      }
    },
    "骑行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycling"
          }
        }
